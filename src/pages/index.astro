---
import Layout from '../layouts/Layout.astro'
import Section from '../components/Section.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { education, experience, profile, projects, skills } from '../data/content'

const nav = [
  ['#proyectos', 'Proyectos'],
  ['#experiencia', 'Experiencia'],
  ['#educacion', 'Educación'],
  ['#contacto', 'Contacto'],
]
---

<Layout title={`${profile.name} · ${profile.role}`} description={profile.summary}>
  <header class="sticky top-0 z-10 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
    <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
      <a href="#" class="font-bold">NA</a>
      <nav class="flex items-center gap-4 text-sm">
        {nav.map(([href, label]) => <a href={href} class="hidden hover:text-indigo-600 sm:inline">{label}</a>)}
        <ThemeToggle />
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-4xl px-4">
    <section class="py-20">
      <p class="text-sm text-slate-500">{profile.location}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
        {profile.name}
      </h1>
      <p class="mt-2 text-xl text-indigo-600 dark:text-indigo-400">{profile.role}</p>
      <p class="mt-6 max-w-2xl leading-relaxed">{profile.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm">
        <a href={`mailto:${profile.email}`} class="rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700">Escríbeme</a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer" class="rounded-lg border border-slate-300 px-4 py-2 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noreferrer" class="rounded-lg border border-slate-300 px-4 py-2 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">GitHub</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-2" aria-label="Habilidades">
        {skills.map((s) => <li class="rounded-full bg-slate-100 px-3 py-1 text-xs dark:bg-slate-800">{s}</li>)}
      </ul>
    </section>

    <Section id="proyectos" title="Proyectos">
      <div class="grid gap-6 md:grid-cols-2">
        {
          projects.map((p) => (
            <article class="flex flex-col rounded-xl border border-slate-200 p-5 dark:border-slate-800">
              <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{p.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed">{p.description}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.stack.map((t) => <li class="rounded bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">{t}</li>)}
              </ul>
              <div class="mt-4 flex gap-4 text-sm font-medium">
                <a href={p.demo} target="_blank" rel="noreferrer" class="text-indigo-600 hover:underline dark:text-indigo-400">Demo →</a>
                <a href={p.repo} target="_blank" rel="noreferrer" class="hover:underline">Código</a>
              </div>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="experiencia" title="Experiencia">
      <ol class="space-y-8 border-l border-slate-200 pl-6 dark:border-slate-800">
        {
          experience.map((job) => (
            <li class="relative">
              <span class="absolute top-1.5 -left-[29px] size-2.5 rounded-full bg-indigo-600" />
              <h3 class="font-semibold text-slate-900 dark:text-white">
                {job.role} · {job.company}
              </h3>
              <p class="text-sm text-slate-500">{job.period}</p>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
                {job.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="educacion" title="Educación">
      <ul class="space-y-4">
        {
          education.map((e) => (
            <li class="flex flex-wrap justify-between gap-2">
              <div>
                <p class="font-medium text-slate-900 dark:text-white">{e.title}</p>
                <p class="text-sm text-slate-500">{e.place}</p>
              </div>
              <span class="text-sm text-slate-500">{e.year}</span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="contacto" title="Contacto">
      <p class="max-w-xl">
        Estoy buscando trabajo como frontend developer, remoto o híbrido en Bogotá. Si tienes una vacante o un proyecto,
        escríbeme a <a href={`mailto:${profile.email}`} class="text-indigo-600 underline dark:text-indigo-400">{profile.email}</a>.
      </p>
    </Section>
  </main>

  <footer class="border-t border-slate-200 py-8 text-center text-xs text-slate-500 dark:border-slate-800">
    Hecho con Astro y Tailwind · {new Date().getFullYear()}
  </footer>
</Layout>
