export type IconName = keyof typeof paths

interface Props {
  name: IconName
  class?: string
}
const { name, class: className = 'size-6' } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
